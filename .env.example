# Haaris (حارس) — UAE LLM Compliance Guardrail — environment configuration
# Copy this file to .env and fill in your Groq key. Never commit .env to git.
#
# Agent 1 (UAE PII) is pure regex — runs locally, no key or model needed.
# Agents 2-4 use the Groq API — free tier at https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Per-agent Groq models (defaults shown)
VALIDATOR_MODEL=llama-3.1-8b-instant     # Agent 2 — Input/Output Validator
MAPPER_MODEL=llama-3.3-70b-versatile     # Agent 3 — Framework Mapper
REPORT_MODEL=llama-3.3-70b-versatile     # Agent 4 — Compliance Report Generator

# MongoDB audit-log storage
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=haaris

# Report output directory (PDFs written here)
REPORTS_DIR=./reports
